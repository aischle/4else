# 4else — environment template
# Copy to .env.local and fill in real values. Do not commit .env.local.

# Canonical site origin, used for metadata, robots.txt and the sitemap.
# Set it in Vercel once the production domain is decided.
NEXT_PUBLIC_SITE_URL=

# Sanity — the blog "Inspirationen" (project 6e5n16nr). Both have safe
# defaults in lib/sanity.ts; set them only to point at another dataset.
NEXT_PUBLIC_SANITY_PROJECT_ID=6e5n16nr
NEXT_PUBLIC_SANITY_DATASET=production

# Sanity read token (Viewer role) for the Studio's Vorschau: lets the site
# read drafts in draft mode and check the Studio's preview secret. Server
# only, never NEXT_PUBLIC. Create it in sanity.io/manage → project 6e5n16nr
# → API → Tokens. Without it the preview answers 503; visitors are unaffected.
SANITY_API_READ_TOKEN=

# Optional: where a click on a preview overlay leads when the page is open
# outside the Studio. Defaults to the hosted Studio; set it to
# http://localhost:3333 to land in the local one.
# NEXT_PUBLIC_SANITY_STUDIO_URL=

# Shared secret for the Sanity webhook that refreshes the blog at once
# (app/api/revalidate). Same value in Vercel and in the webhook's
# x-webhook-secret header. Any long random string.
SANITY_REVALIDATE_SECRET=
