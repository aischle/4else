# 4else — environment template
# Copy to .env.local and fill in real values. Do not commit .env.local.

# Canonical site origin, used for metadata, robots.txt and the sitemap.
# Set it in Vercel once the production domain is decided.
NEXT_PUBLIC_SITE_URL=

# Sanity — the blog "Inspirationen" (project 6e5n16nr). Both have safe
# defaults in lib/sanity.ts; set them only to point at another dataset.
NEXT_PUBLIC_SANITY_PROJECT_ID=6e5n16nr
NEXT_PUBLIC_SANITY_DATASET=production

# Shared secret for the Sanity webhook that refreshes the blog at once
# (app/api/revalidate). Same value in Vercel and in the webhook's
# x-webhook-secret header. Any long random string.
SANITY_REVALIDATE_SECRET=
